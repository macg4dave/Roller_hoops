{
  "Backlog Task Card": {
    "scope": "markdown",
    "prefix": "rh-task",
    "description": "Insert a Roller_hoops backlog task card",
    "body": [
      "### T${1:00} - ${2:Short Task Name}",
      "",
      "- Status: ${3|Ready,In Progress,Blocked,Review,Done,Dropped|}",
      "- Queue: ${4|Now,Next,Later|}",
      "- Phase: ${5:Phase}",
      "- Priority: ${6|P0,P1,P2,P3|}",
      "- Owner Role: ${7|Tech lead,Core owner,UI owner,Data owner,Operations owner,Security owner,Docs owner|}",
      "- Goal: ${8:One-sentence description of the outcome.}",
      "- Scope:",
      "  - ${9:concrete deliverable}",
      "- Files to Touch:",
      "  - ${10:path/to/file}",
      "- Do Not Touch:",
      "  - ${11:path/to/protected-area}",
      "- Dependencies:",
      "  - ${12:None}",
      "- Validation:",
      "  - ${13:command or manual check}",
      "- Definition of Done:",
      "  - ${14:observable completion condition}",
      "- Handoff Notes:",
      "  - ${15:what the next agent should know}"
    ]
  },
  "Issue Intake Card": {
    "scope": "markdown",
    "prefix": "rh-parent",
    "description": "Insert a Roller_hoops parent issue card",
    "body": [
      "### T${1:00} - ${2:Short Parent Issue Name}",
      "",
      "- Status: ${3|Ready,In Progress,Blocked,Review,Done,Dropped|}",
      "- Queue: ${4|Now,Next,Later|}",
      "- Phase: ${5:Phase}",
      "- Priority: ${6|P0,P1,P2,P3|}",
      "- Owner Role: ${7|Tech lead,Core owner,UI owner,Data owner,Operations owner,Security owner,Docs owner|}",
      "- Goal: ${8:One-sentence description of the multi-step outcome.}",
      "- Scope:",
      "  - ${9:concrete outcome}",
      "- Files to Touch:",
      "  - ${10:path/to/doc-or-system-area}",
      "- Do Not Touch:",
      "  - ${11:path/to/protected-area}",
      "- Dependencies:",
      "  - ${12:None}",
      "- Child Tasks:",
      "  - ${13:T00a}",
      "- Validation:",
      "  - manual doc consistency review",
      "  - child task validation listed on each child card",
      "- Definition of Done:",
      "  - the parent issue is decomposed into implementation-ready child tasks",
      "  - affected planning docs are synchronized",
      "- Handoff Notes:",
      "  - ${14:sequencing, blockers, or open decisions}"
    ]
  }
}
