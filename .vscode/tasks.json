{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "agent: show ready queue",
      "type": "shell",
      "command": "grep -E '^\\| T[0-9].*\\| Ready \\|' BACKLOG.md || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Select-String -Path BACKLOG.md -Pattern '^\\| T[0-9].*\\| Ready \\|'"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "agent: show required reading",
      "type": "shell",
      "command": "head -80 AGENTS.md",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "Get-Content AGENTS.md -TotalCount 80"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "git: diff check",
      "type": "shell",
      "command": "git diff --check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ui: npm ci",
      "type": "shell",
      "command": "docker build -f docker/validate/ui-node.Dockerfile --target deps .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ui: gen openapi types",
      "type": "shell",
      "command": "docker build -q -f docker/validate/ui-node.Dockerfile --target generated-types . | tail -n 1 | xargs -I {} sh -c 'cid=$(docker create {}); trap \"docker rm -f $cid >/dev/null\" EXIT; docker cp $cid:/workspace/ui-node/lib/api-types.ts ui-node/lib/api-types.ts'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$image = docker build -q -f docker/validate/ui-node.Dockerfile --target generated-types .; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; $cid = docker create $image; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; try { docker cp \"${cid}:/workspace/ui-node/lib/api-types.ts\" \"ui-node/lib/api-types.ts\"; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } } finally { docker rm -f $cid | Out-Null }"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "ui: test",
      "type": "shell",
      "command": "docker build -f docker/validate/ui-node.Dockerfile --target test .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "ui: build",
      "type": "shell",
      "command": "docker build -f docker/validate/ui-node.Dockerfile --target build .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "go: fmt check",
      "type": "shell",
      "command": "docker build -f docker/validate/core-go.Dockerfile --target fmtcheck .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "go: vet",
      "type": "shell",
      "command": "docker build -f docker/validate/core-go.Dockerfile --target vet .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "go: test",
      "type": "shell",
      "command": "docker build -f docker/validate/core-go.Dockerfile --target test .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "go: test via docker",
      "type": "shell",
      "command": "docker build -f docker/validate/core-go.Dockerfile --target test .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "validate: ui",
      "dependsOrder": "sequence",
      "dependsOn": ["ui: gen openapi types", "ui: test", "ui: build"],
      "problemMatcher": []
    },
    {
      "label": "validate: go",
      "dependsOrder": "sequence",
      "dependsOn": ["go: fmt check", "go: vet", "go: test"],
      "problemMatcher": []
    },
    {
      "label": "validate: available local checks",
      "dependsOrder": "sequence",
      "dependsOn": ["git: diff check", "validate: go", "validate: ui"],
      "problemMatcher": []
    },
    {
      "label": "docker: dev stack up",
      "type": "shell",
      "command": "docker compose --profile dev up --build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: stack down",
      "type": "shell",
      "command": "docker compose --profile dev down -v",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: smoke test",
      "type": "shell",
      "command": "docker compose --profile prod up --build --abort-on-container-exit",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
