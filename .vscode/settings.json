{
  "typescript.tsdk": "ui-node/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "npm.packageManager": "npm",
  "python.terminal.useEnvFile": true,
  "go.testFlags": ["-count=1"],
  "go.toolsManagement.autoUpdate": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/coverage": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/coverage": true,
    "**/dist": true,
    "**/build": true
  },
  "markdown.validate.enabled": true,
  "yaml.validate": true
}
