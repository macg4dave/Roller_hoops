# Auto-detect text files and normalise line endings to LF in the repo.
* text=auto eol=lf

# Ensure these always use LF (critical for Docker builds on all platforms).
*.sh         text eol=lf
*.command    text eol=lf
*.ps1        text eol=lf
*.cmd        text eol=crlf
*.sql        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.css        text eol=lf
*.go         text eol=lf
*.mod        text eol=lf
*.sum        text eol=lf
*.toml       text eol=lf
Dockerfile   text eol=lf
Makefile     text eol=lf
.env*        text eol=lf
.dockerignore text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Binary files — do not touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
